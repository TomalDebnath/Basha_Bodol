# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=bashabodol_app        # least-privilege user, NOT root (see SECURITY.md)
DB_PASSWORD=change-me
DB_NAME=basha_bodol
# DB_SSL=true                 # enable for managed/remote databases

# 48+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=8

# Set to 1 when behind a reverse proxy / PaaS (Render, Railway, ngrok, nginx)
# TRUST_PROXY=1
# Only if the frontend is hosted on a different origin:
# CLIENT_URL=https://your-frontend.example.com
